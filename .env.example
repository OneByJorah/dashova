# dashova — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Dashboard ──────────────────────────────────────────────
COMPOSE_PROJECT_NAME=dashova
ADMIN_USER=admin
ADMIN_PASSWORD_BCRYPT=<set-value>
SECRET_KEY=change-me
DASHBOARD_PORT=3000
API_PORT=42000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database (demo defaults; change before production) ─────
DATABASE_URL=postgresql://dashova:change-me@timescaledb:5432/dashova
POSTGRES_USER=dashova
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dashova

# ── Telegram (optional) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=<set-value>
TELEGRAM_ADMIN_CHAT_ID=

# ── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
